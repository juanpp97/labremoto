# Copiar a .env (que NO se versiona) y completar. python-decouple lo lee desde el
# directorio de trabajo del servidor. Las variables de entorno tienen prioridad.

# --- Obligatorias -----------------------------------------------------------
JWT_KEY=cambiar-por-un-secreto-largo-y-aleatorio
DATABASE_URI=mysql+pymysql://USUARIO:CLAVE@HOST:3306/BASE

# --- Lease (defaults entre paréntesis) --------------------------------------
# LEASE_DURATION_S=900            # límite duro de la sesión
# HEARTBEAT_EVERY_S=20            # cada cuánto debe llegar un heartbeat
# HEARTBEAT_TIMEOUT_S=75          # sin heartbeat este tiempo, se libera
# WATCHDOG_TICK_S=5
# SAFE_STATE_RETRY_INITIAL_S=2
# SAFE_STATE_RETRY_MAX_S=30
# JWT_LIFETIME_S=3600             # vida del login (no de la sesión de laboratorio)

# --- Proceso único ----------------------------------------------------------
# Lock para impedir un segundo proceso/worker. Vacío = desactivado.
# LEASE_LOCK_FILE=/run/labrem/lease.lock    # default: <tmp>/labrem-lease.lock

# --- Logs -------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json                 # json | text

# --- CORS -------------------------------------------------------------------
# En producción frontend y API comparten dominio (proxy de Apache).
# CORS_ORIGINS=*                  # lista separada por comas

# --- gunicorn (gunicorn.conf.py) -------------------------------------------
# GUNICORN_BIND=0.0.0.0:80
# GUNICORN_THREADS=6
# GUNICORN_LOGLEVEL=info
# GUNICORN_ACCESSLOG=1            # access log con X-Forwarded-For (apagado por defecto)
